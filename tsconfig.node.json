{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023"], "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "verbatimModuleSyntax": true,
    "isolatedModules": true, "types": ["node"], "allowImportingTsExtensions": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "scripts/**/*.ts"]
}
